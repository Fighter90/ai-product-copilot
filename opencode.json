{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md", "scripts/swarm/README.md"],
  "agents": {
    "executor": {
      "description": "Swarm executor: implements ONE Linear issue strictly inside its cwd (the swarm worktree). git push, tags, branch mutations and the user's main checkout are forbidden.",
      "permissions": [
        {
          "action": "shell",
          "resource": "cd /Users/sergejemelanov/Projects/yandex-metrika-analyse-dashboard*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "cd /Users/sergejemelanov/Projects/.swarm/yamd",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "cd /Users/sergejemelanov/Projects/.swarm/yamd *",
          "effect": "deny"
        },
        { "action": "shell", "resource": "git *push*", "effect": "deny" },
        { "action": "shell", "resource": "git tag*", "effect": "deny" },
        { "action": "shell", "resource": "git checkout*", "effect": "deny" },
        { "action": "shell", "resource": "git switch*", "effect": "deny" },
        { "action": "shell", "resource": "git branch*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" },
        { "action": "shell", "resource": "git rebase*", "effect": "deny" },
        { "action": "shell", "resource": "git merge*", "effect": "deny" },
        { "action": "shell", "resource": "git cherry-pick*", "effect": "deny" },
        { "action": "shell", "resource": "git restore*", "effect": "deny" },
        { "action": "shell", "resource": "git clean*", "effect": "deny" },
        { "action": "shell", "resource": "git stash*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "git -C /Users/sergejemelanov/Projects/yandex-metrika-analyse-dashboard*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git -C /Users/sergejemelanov/Projects/.swarm/yamd*",
          "effect": "deny"
        },
        { "action": "shell", "resource": "gh pr create*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
        { "action": "shell", "resource": "gh release *", "effect": "deny" },
        { "action": "shell", "resource": "gh workflow run*", "effect": "deny" },
        {
          "action": "edit",
          "resource": "/Users/sergejemelanov/Projects/yandex-metrika-analyse-dashboard/*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "/Users/sergejemelanov/Projects/yandex-metrika-analyse-dashboard",
          "effect": "deny"
        },
        { "action": "edit", "resource": "opencode.json", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/**", "effect": "deny" }
      ]
    }
  }
}
