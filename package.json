{
  "name": "productcamp-analytics",
  "version": "3.4.35",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm --filter @pca/backend dev\" \"pnpm --filter @pca/frontend dev\"",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm build && node --test scripts/swarm/orchestrator.test.mjs",
    "coverage": "pnpm -r --if-present coverage",
    "e2e": "playwright test",
    "seed": "pnpm --filter @pca/backend seed",
    "auth": "pnpm --filter @pca/backend auth",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-versions": "node scripts/sync-versions.mjs",
    "guides": "node scripts/build-guides.mjs",
    "guides:ru": "node scripts/build-guides.mjs --lang ru",
    "guides:en": "node scripts/build-guides.mjs --lang en",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "glob@<14.0.2": ">=14.0.2",
      "minimatch@>=7 <11.0.1": ">=11.0.1"
    }
  }
}
