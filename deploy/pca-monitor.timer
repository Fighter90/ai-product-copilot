# Таймер: проверка здоровья API каждые 5 минут.
# Включение: systemctl enable --now pca-monitor.timer
# Проверка:  systemctl list-timers pca-monitor.timer

[Unit]
Description=Run PCA health check every 5 minutes

[Timer]
# Каждые 5 минут: 00, 05, 10, ...
OnCalendar=*:0/5

# Persistent не ставим: догонять «пропущенные» проверки после простоя бессмысленно,
# следующий тик придёт на ближайшей 5-минутной границе.

Unit=pca-monitor.service

[Install]
WantedBy=timers.target
