# Таймер: синк Метрики каждые 30 минут (ANA-74 — «актуальный дашборд»).
# Включение: systemctl enable --now pca-sync.timer
# Проверка:  systemctl list-timers pca-sync.timer

[Unit]
Description=Run PCA Metrika sync every 30 minutes

[Timer]
# Каждая получасовая метка: :00 и :30 по локальному времени сервера.
# ВНИМАНИЕ: на свежей Ubuntu часовой пояс часто UTC; при необходимости:
#   timedatectl set-timezone Europe/Moscow
OnCalendar=*:0/30

# Разброс запусков, чтобы не бить в API Метрики синхронно с чужими кронами.
RandomizedDelaySec=5min

# Если сервер был выключен в слот запуска — догнать при старте.
Persistent=true

Unit=pca-sync.service

[Install]
WantedBy=timers.target
